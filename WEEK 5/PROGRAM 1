#include <iostream>
using namespace std;

int main() {
    int n, sum = 0;

    cout << "Enter number of elements: ";
    cin >> n;

    // Dynamic memory allocation
    int *arr = new int[n];

    cout << "Enter " << n << " elements:" << endl;
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
        sum += arr[i];
    }

    cout << "Sum of elements = " << sum << endl;

    // Free allocated memory
    delete[] arr;

    return 0;
}
